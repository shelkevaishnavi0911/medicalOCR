spring.application.name=MedicalReportOcr

 servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 20MB

server.port= 8080

app:
  auth:
    token: ${AUTH_TOKEN}

  datalab:
    api-key: ${DATALAB_API_KEY}
    base-url: ${DATALAB_BASE_URL:https://www.datalab.to}

management:
  endpoints:
    web:
      exposure:
        include: health
